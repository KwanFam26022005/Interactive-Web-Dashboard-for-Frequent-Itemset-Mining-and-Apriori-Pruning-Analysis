# Local configuration and secrets
.env
.env.*
!.env.example

# IDE / OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Runtime state
/storage/uploads/
/storage/logs/
/storage/cache/
/storage/results/
